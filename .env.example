# --- Database (SQLite via libSQL, zero setup needed) ---
DATABASE_URL=file:local.db
# For cloud deploys (e.g. Vercel), use a free Turso database instead:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_AUTH_TOKEN=

# --- Auth (NextAuth) ---
# Generate one with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# --- AI provider ---
# ollama     = local, open-source models, no API key, no restrictions (default)
# groq       = FREE cloud tier serving open-source Llama models (needs free
#              key from https://console.groq.com) — best option for mobile
# openrouter = free + paid cloud models (key from https://openrouter.ai)
# openai     = requires OPENAI_API_KEY
# anthropic  = requires ANTHROPIC_API_KEY
AI_PROVIDER=ollama

# Ollama (install from https://ollama.com, then: ollama pull llama3.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq (only used if AI_PROVIDER=groq) — free tier, no card needed
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (only used if AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (only used if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (only used if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
